	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Adiciona automaticamente o token em todas as requisições (exceto login)",
					"var requestUrl = pm.request.url.toString();",
					"if (!requestUrl.includes('/api/login')) {",
					"    var token = pm.environment.get('token') || pm.collectionVariables.get('token');",
					"    if (token) {",
					"        // Verifica se já existe o header Authorization",
					"        var authHeader = pm.request.headers.get('Authorization');",
					"        if (!authHeader) {",
					"            pm.request.headers.add({",
					"                key: 'Authorization',",
					"                value: 'Bearer ' + token",
					"            });",
					"        } else {",
					"            // Atualiza o header existente",
					"            pm.request.headers.upsert({",
					"                key: 'Authorization',",
					"                value: 'Bearer ' + token",
					"            });",
					"        }",
					"    }",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "Autenticação",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        // Salva o token na variável de ambiente (se existir)",
									"        if (pm.environment) {",
									"            pm.environment.set(\"token\", jsonData.token);",
									"        }",
									"        // Salva o token na variável de coleção (sempre funciona)",
									"        pm.collectionVariables.set(\"token\", jsonData.token);",
									"        console.log(\"✅ Token salvo com sucesso!\");",
									"        console.log(\"Token: \" + jsonData.token.substring(0, 20) + \"...\");",
									"    } else {",
									"        console.log(\"❌ Token não encontrado na resposta\");",
									"    }",
									"} else {",
									"    console.log(\"❌ Erro no login: \" + pm.response.code);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/login",
							"host": ["{{base_url}}"],
							"path": ["api", "login"]
						},
						"description": "Realiza login e obtém token de autenticação"
					},
					"response": []
				},
