# =============================================================================
# Copie para .env e rode: php artisan key:generate
#
# Os valores abaixo são os do ambiente Docker (docker compose up -d), que é a
# forma documentada de rodar o projeto — veja o README.
# Rodando fora do Docker, troque os hosts por 127.0.0.1 (ver comentários).
#
# Deploy (Railway/produção): preencha APP_KEY, APP_URL, DB_*, CORS_ALLOWED_ORIGINS
# e use APP_ENV=production com APP_DEBUG=false.
# =============================================================================

# --- APP ---
APP_NAME=Laravel
APP_ENV=local
# Gerado por `php artisan key:generate` — nunca versione a chave real.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- CORS ---
# Origens do frontend separadas por vírgula. Vazio = libera qualquer origem (*).
# Em produção, informe o domínio real (ex.: https://seu-app.vercel.app).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- LOG ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE ---
# DB_HOST=mysql é o nome do serviço no docker-compose; fora do Docker use 127.0.0.1.
# Atenção (Docker): o compose usa DB_DATABASE e DB_PASSWORD para criar o banco e
# definir a senha de root do container MySQL. Portanto DB_PASSWORD não pode ficar
# vazio (o container não sobe) e DB_USERNAME precisa continuar 'root' — o compose
# não provisiona outros usuários. O valor abaixo é só para desenvolvimento local.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=secret

# A suíte de testes usa um banco separado (laravel_testing), configurado em
# phpunit.xml. Ele precisa ser criado uma vez — veja "Banco de testes" no README.

# --- AUTH ---
# A API autentica via Sanctum (Bearer token). O guard padrão já é 'sanctum'
# em config/auth.php; descomente apenas se precisar sobrescrever.
# AUTH_GUARD=sanctum

# --- SESSION ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- CACHE / QUEUE (local: database | com Redis: redis) ---
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- REDIS (só se CACHE_STORE=redis ou QUEUE_CONNECTION=redis) ---
# Fora do Docker, use 127.0.0.1.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- MAIL ---
# Padrão do Docker: MailHog (interface em http://localhost:8025).
# Fora do Docker, use MAIL_MAILER=log para escrever os e-mails no log.
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- IMPORTAÇÃO DE PROMISSÓRIA POR IMAGEM ---
# provider: groq | openai. Preencha a chave do provider escolhido.
PROMISSORIA_IMAGE_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=

# --- OUTROS ---
BCRYPT_ROUNDS=12
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
APP_MAINTENANCE_DRIVER=file

VITE_APP_NAME="${APP_NAME}"
