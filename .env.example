# =============================================================================
# CHECKLIST RAILWAY: preencha APP_KEY, APP_URL, DB_*, CORS_ALLOWED_ORIGINS
# =============================================================================

# --- APP ---
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- CORS (obrigatório se frontend na Vercel) ---
CORS_ALLOWED_ORIGINS=https://seu-app.vercel.app

# --- LOG ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE (Railway: use variáveis do addon MySQL/Postgres) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# --- SESSION ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- CACHE / QUEUE (local: database | Railway com Redis: redis) ---
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- REDIS (só se CACHE_STORE=redis ou QUEUE_CONNECTION=redis) ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- MAIL ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PROMISSORIA_IMAGE_PROVIDER=groq
GROQ_API_KEY=

# --- OUTROS ---
BCRYPT_ROUNDS=12
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
APP_MAINTENANCE_DRIVER=file

VITE_APP_NAME="${APP_NAME}"
