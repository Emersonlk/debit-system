        "/promissorias/{promissoria}/pagamento-parcial": {
            "post": {
                "tags": [
                    "Promissórias"
                ],
                "summary": "Registrar pagamento parcial",
                "description": "Registra um pagamento parcial (valor_pago, data_pagamento, observacoes opcional).",
                "operationId": "a7f58b7e5fb2906246a5e33c1dca504a",
                "parameters": [
                    {
                        "name": "promissoria",
                        "in": "path",
                        "description": "ID da promissória",
                        "required": true,
                        "example": 1
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "valor_pago",
                                    "data_pagamento"
                                ],
                                "properties": {
                                    "valor_pago": {
                                        "type": "number",
                                        "example": 500
                                    },
                                    "data_pagamento": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-02-05"
                                    },
                                    "observacoes": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Pagamento registrado"
                    },
                    "401": {
                        "description": "Não autenticado"
                    },
                    "404": {
                        "description": "Promissória não encontrada"
                    },
                    "422": {
                        "description": "Validação (valor excedente, já paga, cancelada)"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
